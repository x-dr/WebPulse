# Use explicitly: docker compose --env-file .env.production -f compose.yml ...
WEBPULSE_DOMAIN=stats.example.com
ADMIN_ORIGIN=https://stats.example.com
DB_NAME=webpulse
SECRET_DIR=./secrets
TLS_DIR=./tls
# Independent HTTPS service, preferably on another host/storage failure domain.
DELETION_JOURNAL_URL=https://journal.example.com:8443
JOURNAL_CA_FILE=./tls/journal-ca.pem
# Optional local-journal profile (single-host acceptance, separate storage).
JOURNAL_DATA_DIR=./journal-data
JOURNAL_TLS_DIR=./tls/journal
WEBPULSE_API_IMAGE=webpulse-api:0.1.0-m4
WEBPULSE_WEB_IMAGE=webpulse-web:0.1.0-m4
WEB_BIND_IP=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
# Reserve this subnet; change subnet AND all three addresses together on conflicts.
PRIVATE_SUBNET=172.30.88.0/24
WEB_PRIVATE_IP=172.30.88.10
API_PRIVATE_IP=172.30.88.20
DB_PRIVATE_IP=172.30.88.30
