{
  "name": "webpulse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": ">=10.20.0 <11"
  },
  "scripts": {
    "dev": "pnpm --filter @webpulse/shared build && pnpm --parallel --filter @webpulse/server --filter @webpulse/dashboard dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @webpulse/shared build && pnpm -r typecheck && tsc -p tsconfig.tools.json",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter @webpulse/shared build && vitest run --project unit",
    "test:integration": "pnpm --filter @webpulse/shared build && vitest run --project integration",
    "test:e2e": "playwright test",
    "db:migrate": "pnpm --filter @webpulse/server db:migrate",
    "test:postgres": "pnpm --filter @webpulse/shared build && vitest run --project postgres"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "eslint": "10.14.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.72.1",
    "globals": "16.5.0",
    "prettier": "3.9.10",
    "@electric-sql/pglite": "0.3.16",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2"
  }
}
