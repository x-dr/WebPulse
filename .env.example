# Local development only. Copy to .env; do not commit the real password.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=webpulse_dev
DB_USER=webpulse_dev
DB_PASSWORD=
# Alternatively set DB_PASSWORD_FILE; do not set both.
DB_POOL_MAX=8
# M1 management origin; exact scheme/host/port. HTTPS required in production.
ADMIN_ORIGIN=http://127.0.0.1:5173
# Three independent 32-byte keys, encoded as 64 hex characters in each file.
# Relative paths resolve from the workspace root, not the service working directory.
VISITOR_HMAC_KEY_FILE=secrets/visitor_hmac_key.txt
IP_HMAC_KEY_FILE=secrets/ip_hmac_key.txt
CSRF_HMAC_KEY_FILE=secrets/csrf_hmac_key.txt
# Each *_FILE may instead use the corresponding value variable, but never both.
