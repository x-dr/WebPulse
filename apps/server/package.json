{
  "name": "@webpulse/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "dev": "node --watch --import tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "node --import tsx src/cli.ts database:migrate",
    "admin:create": "node --import tsx src/cli.ts admin:create"
  },
  "dependencies": {
    "@webpulse/shared": "workspace:*",
    "fastify": "5.12.8",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "tsx": "4.23.15"
  }
}
